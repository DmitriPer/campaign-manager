{
  "name": "campaign-manager",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config": "node scripts/write-supabase-config.mjs",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run config",
    "test": "ng test --watch=false",
    "db:start": "supabase db start",
    "db:test": "supabase test db",
    "db:reset": "supabase db reset",
    "test:realtime": "node tests/realtime/user-channel.mjs",
    "test:api": "node tests/api/campaigns.mjs && node tests/api/characters.mjs && node tests/api/pdfs.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@supabase/supabase-js": "2.119.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  }
}
